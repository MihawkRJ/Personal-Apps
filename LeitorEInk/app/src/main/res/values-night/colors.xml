    <color name="eink_divider">#3A382F</color>
    <color name="eink_disabled">#55534A</color>
    <color name="eink_accent">#E8E3D7</color>
    <color name="eink_ripple">#1FE8E3D7</color>

    <color name="eink_page_background">#121110</color>
    <color name="eink_page_text">#E5E0D3</color>
